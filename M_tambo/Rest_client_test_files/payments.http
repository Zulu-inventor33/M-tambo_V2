    "asset_count": 2
  },
  {
    "id": 2,
    "maintenance_company_name": "KentwoodPowers Inc.",
    "total_amount": "14000.00",
    "calculation_date": "2025-02-05T00:00:00Z",
    "due_date": "2025-03-05T23:59:59Z",
    "status": "pending",
    "payment_date": null,
    "assets": [
      {
        "id": 3,
